@page
@model MyRazorApp.Pages.IndexModel

@* On the left side of the page, there will be a form that collects:
o Class Name
o Student Count
o Description
• On the right side, there will be a table that displays all the submitted class data.
• The table will have the following columns:
o Id
o Class Name
o Student Count
o Description
o Actions (Edit and Delete)
The data should be validated and added to a static list each time the form is submitted. The data will
then be displayed in the table *@

<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-4">
        <h1 class="text-center mb-4">Class Management</h1>
        <div class="row">
            <!-- Sol taraf: Form -->
            <div class="col-md-4">
                <form method="post">
                    <input type="hidden" asp-for="IsEditing" />
                    <input type="hidden" asp-for="NewClass.Id" />

                    <div class="mb-3">
                        <label class="form-label">Class Name</label>
                        <input asp-for="NewClass.ClassName" class="form-control" />
                        <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Student Count</label>
                        <input asp-for="NewClass.StudentCount" class="form-control" />
                        <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                        <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        @(Model.IsEditing ? "Update Class" : "Add Class")
                    </button>
                </form>
            </div>

            <!-- Sağ taraf: Tablo -->
            <div class="col-md-8">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Class Name</th>
                            <th>Student Count</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var classInfo in IndexModel.ClassList)
                        {
                            <tr>
                                <td>@classInfo.Id</td>
                                <td>@classInfo.ClassName</td>
                                <td>@classInfo.StudentCount</td>
                                <td>@classInfo.Description</td>
                                <td>
                                    <form method="post">
                                        <button type="submit" asp-page-handler="Edit" asp-route-id="@classInfo.Id" class="btn btn-warning btn-sm">Edit</button>
                                        <button type="submit" asp-page-handler="Delete" asp-route-id="@classInfo.Id" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
