@model MyRazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<div class="row">
    @* Left Column: Add/Edit Form *@
    <div class="col-md-6">
        <h2>@(Model.EditId == 0 ? "Add New Class" : "Edit Class")</h2>
        <form method="post">
            <input type="hidden" asp-for="EditId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-2">
                <label asp-for="NewClass.ClassName"></label>
                <input asp-for="NewClass.ClassName" class="form-control" />
                <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="NewClass.StudentCount"></label>
                <input asp-for="NewClass.StudentCount" type="number" class="form-control" />
                <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="NewClass.Description"></label>
                <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                <span asp-validation-for="NewClass.Description" class="text-danger"></span>
            </div>
            <button type="submit" asp-page-handler="Add" class="btn btn-primary btn-full-width">
                @(Model.EditId == 0 ? "Add Class" : "Update Class")
            </button>
            @if (Model.EditId != 0)
            {
                <a asp-page="./Index" class="btn btn-danger">Cancel Edit</a>
            }
        </form>
    </div>

    @* Right Column: Class List, Filter, Pagination, and Export *@
    <div class="col-md-6">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h2>Class List</h2>
            <form method="post" asp-page="./Logout">
                <button type="submit" class="btn btn-primary">Logout</button>
            </form>
        </div>

        @if (TempData["ExportMessage"] != null)
        {
            <div class="alert alert-info">@TempData["ExportMessage"]</div>
        }

        <div class="mb-3 d-flex align-items-end">
            <div class="flex-grow-1 me-2">
                <label asp-for="SearchString" class="visually-hidden">Filter by Class Name</label>
                <input type="text" asp-for="SearchString" class="form-control" placeholder="Filter by Class Name..."
                       id="searchInput" />
            </div>
            <a asp-page="./Index" class="btn btn-danger me-2">Clear</a>
        </div>

        <form method="post" class="mb-3">
            <input type="hidden" id="selectedColumns" name="selectedColumns" value="" />
            <input type="hidden" asp-for="SearchString" />
            <button type="submit" asp-page-handler="ExportJson" class="btn btn-success">Export JSON</button>
        </form>

        <table class="table table-striped table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th style="display:none;" data-column="Id">ID</th>
                    <th data-column="ClassName" class="column-selector">Class Name</th>
                    <th data-column="StudentCount" class="column-selector">Student Count</th>
                    <th data-column="Description" class="column-selector">Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ClassList.Any())
                {
                    @foreach (var item in Model.ClassList)
                    {
                        <tr>
                            <td style="display:none;" data-column="Id">@item.Id</td>
                            <td data-column="ClassName">@item.ClassName</td>
                            <td data-column="StudentCount">@item.StudentCount</td>
                            <td data-column="Description">@item.Description</td>
                            <td>
                                <a asp-page="./Index"
                                   asp-route-editId="@item.Id"
                                   asp-route-currentPage="@Model.CurrentPage"
                                   asp-route-searchString="@Model.SearchString"
                                   class="btn btn-sm btn-warning me-1">
                                    <img src="/images/pencil-solid.svg" alt="Edit"
                                         style="width: 1.2em; vertical-align: middle;" />
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id"
                                      style="display: inline-block;">
                                    <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                                    <input type="hidden" name="searchString" value="@Model.SearchString" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to delete this class?');">
                                        <img src="/images/trash-solid.svg" alt="Delete"
                                             style="width: 1.2em; vertical-align: middle;" />
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No classes found matching your criteria.</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center flex-wrap">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="./Index" asp-route-currentPage="@(Model.CurrentPage - 1)" asp-route-searchString="@Model.SearchString">Previous</a>
                    </li>
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                        if (startPage > 1) {
                            <li class="page-item"><a class="page-link" asp-page="./Index" asp-route-currentPage="1" asp-route-searchString="@Model.SearchString">1</a></li>
                            if (startPage > 2) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                        }
                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-page="./Index" asp-route-currentPage="@i" asp-route-searchString="@Model.SearchString">@i</a>
                            </li>
                            }
                        if (endPage < Model.TotalPages) {
                            if (endPage < Model.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                            <li class="page-item"><a class="page-link" asp-page="./Index" asp-route-currentPage="@Model.TotalPages" asp-route-searchString="@Model.SearchString">@Model.TotalPages</a></li>
                        }
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-page="./Index" asp-route-currentPage="@(Model.CurrentPage + 1)" asp-route-searchString="@Model.SearchString">Next</a>
                    </li>
                </ul>
            </nav>
            <div class="text-center">
                Page @Model.CurrentPage of @Model.TotalPages (Total Items: @Model.TotalCount)
            </div>
        }
        else if (Model.TotalCount > 0)
        {
            <div class="text-center">
                Total Items: @Model.TotalCount
            </div>
        }

    </div>
</div>

@section Styles {
    <style>
        .selected-column,
        .selected-column th,
        .selected-column td {
            background-color: lightblue !important;
        }
    </style>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const columnSelectors = document.querySelectorAll('th.column-selector');
            const selectedColumnsInput = document.getElementById('selectedColumns');
            let selectedColumns = new Set();
            let typingTimer;
            const doneTypingInterval = 800;

            searchInput.addEventListener('input', function () {
                clearTimeout(typingTimer);
                typingTimer = setTimeout(doneTyping, doneTypingInterval);
            });

            function doneTyping() {
                window.location.href = '?SearchString=' + encodeURIComponent(searchInput.value);
            }

            function highlightColumn(column, shouldHighlight) {
                const columnIndex = Array.from(document.querySelectorAll('th')).findIndex(th => th.dataset.column === column);
                if (columnIndex === -1) return;

                const table = document.querySelector('table');
                if (!table) return;

                const rows = table.querySelectorAll('tr');
                rows.forEach(row => {
                    const cells = row.querySelectorAll('td, th');
                    if (cells[columnIndex]) {
                        if (shouldHighlight) {
                            cells[columnIndex].classList.add('selected-column');
                        } else {
                            cells[columnIndex].classList.remove('selected-column');
                        }
                    }
                });
            }

            columnSelectors.forEach(th => {
                th.addEventListener('click', function () {
                    const column = this.dataset.column;
                    if (selectedColumns.has(column)) {
                        selectedColumns.delete(column);
                        highlightColumn(column, false);
                    } else {
                        selectedColumns.add(column);
                        highlightColumn(column, true);
                    }
                    selectedColumnsInput.value = Array.from(selectedColumns).join(',');
                });
            });
        });
    </script>
}